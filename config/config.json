{
  "site": {
    "titre": "Carte des sites web publics de Côte d'Ivoire",
    "domaine": "gouvci.arnoldkouya.com"
  },
  "check": {
    "concurrency": 8,
    "timeoutMs": 15000,
    "userAgent": "Mozilla/5.0 (compatible; graph-gouv-ci/1.0; +https://github.com/arnoldkouya/graph-gouv-cote-divoire)"
  },
  "sousDomaines": {
    "racines": ["gouv.ci"],
    "delaiMs": 2000,
    "excludePatterns": [
      "^(api|mail|smtp|imap|pop|mx|autodiscover|autoconfig|webmail|vpn|ftp|sftp|ns\\d*|dns|ldap|sso|auth|cas|proxy|relay|sip|owa|exchange|cdn|static|assets|img|media)[.-]",
      "(^|[.-])(test|tests|recette|rec|preprod|pre-prod|staging|stg|dev|demo|int|integration|qualif|formation|sandbox|uat)([.-]|\\d)",
      "^(adm|admin|administration|backoffice|bo|gestion|intranet|extranet|cms|matomo|stats|grafana|kibana|gitlab|git|jenkins|ci|monitoring|status|keycloak|login|idp|oauth|storage|files|backup|vault|db|pma|redis|elastic|solr|remote|vpn)([.-]|\\d)",
      "(^|[.-])api([.-]|\\d)",
      "^(www\\d|origin|lb|node|srv|server|host|vm|preview)[.-]"
    ]
  }
}
